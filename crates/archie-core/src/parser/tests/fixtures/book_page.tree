    Section level=1
      Heading
        Text "archie ls"
      Paragraph
        Code "archie ls"
        Text " lists the contents of a corpus."
      Section level=2
        Heading
          Text "Synopsis"
        CodeBlock info="console" value="$ archie ls"
        Paragraph
          Text "*Arguments and options are not yet specified.*"
      Section level=2
        Heading
          Text "Not yet specified"
        List
          Item
            Paragraph
              Text "What a row of the listing carries: a path alone, or a path together with the\nresource's type and other frontmatter values."
          Item
            Paragraph
              Text "Whether a listing recurses."
          Item
            Paragraph
              Text "Whether non-markdown files are listed alongside markdown ones."
          Item
            Paragraph
              Text "Whether the ignore list in "
              Code "archie.toml"
              Text " applies."
          Item
